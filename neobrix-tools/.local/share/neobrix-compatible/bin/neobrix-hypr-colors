#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    dawn)
        accent="f6a97e"
        ink="171210"
        shadow="171210"
        ;;
    dusk)
        accent="f0a377"
        ink="0d0a08"
        shadow="000000"
        ;;
    *)
        echo "Usage: neobrix-hypr-colors dawn|dusk" >&2
        exit 2
        ;;
esac

hyprctl eval "
hl.config({
    general = {
        col = {
            active_border = 'rgba(${accent}ff)',
            inactive_border = 'rgba(${ink}ff)'
        }
    },
    decoration = {
        shadow = {
            color = 'rgba(${shadow}ff)',
            color_inactive = 'rgba(${shadow}80)'
        }
    }
})
"

